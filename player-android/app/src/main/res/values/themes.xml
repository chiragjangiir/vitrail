<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        AppCompat-based fullscreen kiosk theme. MUST descend from Theme.AppCompat
        because MainActivity/SetupActivity extend AppCompatActivity (a platform
        theme crashes createSubDecor with "You need to use a Theme.AppCompat theme").
    -->
    <style name="Theme.SignFlow" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/launcher_bg</item>
        <item name="colorAccent">@color/accent</item>
    </style>
</resources>
