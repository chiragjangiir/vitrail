# SignFlow CMS — Variables d'environnement
# cp .env.example .env  puis remplir les valeurs

# ── Base de données ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://signflow:signflow@localhost:5432/signflow
POSTGRES_USER=signflow
POSTGRES_PASSWORD=signflow
POSTGRES_DB=signflow

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Auth ───────────────────────────────────────────────────────────────────────
CMS_JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
CMS_JWT_ALGORITHM=HS256
CMS_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
CMS_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ── Stockage (MinIO / S3) ──────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
# MINIO_PUBLIC_ENDPOINT : hostname:port accessible depuis les browsers ET les players.
# OBLIGATOIRE pour que les URLs signees (vignettes, lectures video) fonctionnent.
# Dev local  : localhost:9000
# Serveur LAN : 192.168.1.10:9000  (IP LAN du serveur)
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_MEDIA=signflow-media
MINIO_USE_SSL=false

# ── Event Bus ──────────────────────────────────────────────────────────────────
EVENT_BUS_BACKEND=redis_streams

# ── LiteLLM ────────────────────────────────────────────────────────────────────
CMS_LITELLM_URL=http://litellm:4000
ANTHROPIC_API_KEY=

# ── SMTP ───────────────────────────────────────────────────────────────────────
# Dev local : mailpit (docker compose) — http://localhost:8025 pour lire les emails
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@signflow.io
SMTP_TLS=false

# ── Push Notifications Mobile ──────────────────────────────────────────────────
CMS_FCM_SERVER_KEY=
CMS_APNS_KEY_ID=
CMS_APNS_TEAM_ID=
CMS_APNS_PRIVATE_KEY=

# ── Stock Library ──────────────────────────────────────────────────────────────
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# ── signflow-feed-proxy ────────────────────────────────────────────────────────
FEED_PROXY_URL=http://feed-proxy:8001
VAULT_ADDR=
VAULT_TOKEN=

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
